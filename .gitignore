# 本地工作产物：会话、原始证据、设计导出；长期规则见 docs/REPOSITORY-CONTENT.md
/_local/
docs/plans/
docs/design/app-design-runs/
docs/design/image2-concepts/
docs/design/APP-DESIGN-AUTOPILOT.md

# Design handoffs retain reviewed Markdown only, not tool exports or chat transcripts.
/docs/design/claude-design-handoff/**/*
!/docs/design/claude-design-handoff/**/
!/docs/design/claude-design-handoff/**/*.md
/docs/design/claude-design-handoff/chats/
/docs/design/claude-design-handoff/project/
/docs/design/claude-design-handoff/project-refresh-*/
/docs/design/claude-design-handoff/video-stage/

# Keep only the reproducible site / App Store pipelines public.
# The promotional video campaign, provider probes and generation receipts stay local.
/marketing/*
!/marketing/README.md
!/marketing/appstore/
!/marketing/preview/
!/marketing/site/
/marketing/appstore/*
!/marketing/appstore/generate-assets.sh
/marketing/preview/*
!/marketing/preview/README.md
!/marketing/preview/assemble-compose.sh
!/marketing/preview/assemble.sh
!/marketing/preview/make-preview.sh
!/marketing/preview/record.sh
!/marketing/preview/render_assets.py
/marketing/site/*
!/marketing/site/README.md
!/marketing/site/generate-assets.sh
!/marketing/site/smoke.py
!/marketing/site/write-manifest.py

# local agent / IDE state
.claude/
.codex/
.agents/

# Xcode per-user state
**/xcuserdata/
*.xcuserstate

# stray render/tool artifacts from the design phase
.playwright-mcp/
/claude-contact-sheet.png
/design-progress-*.yml
/*.jpeg
/*.png

# local social-post publishing package (not used by product or site builds)
/docs/design/claude-design-handoff/xhs-off-lan/

# release secrets — never commit
.env
.env.*
*.p12
# Apple .p8 secrets — both APNs push (iosApp/AuthKey_*.p8) AND the App Store Connect API key
# used by ios-release.yml (iosApp/Github_AuthKey_*.p8). Never commit either; they go in CI as secrets.
*.p8
# Firebase service-account / admin SDK keys for the relay's FCM sender
/firebase/
*-adminsdk-*.json
# build artifacts produced by scripts/release-*.sh
/cc-pocket-daemon-*.tar.gz
/cc-pocket-desktop-*.dmg

# generated App Preview videos (rebuild with marketing/preview/make-preview.sh)
/marketing/preview/out/

# Firebase client configs — kept local, not in the public repo (users install the binary,
# they don't build the mobile app from source)
mobile/androidApp/google-services.json
# Keep pre-migration local configurations private until their owners remove them.
mobile/composeApp/google-services.json
iosApp/iosApp/GoogleService-Info.plist
mobile/composeApp/src/desktopMain/resources/ga4.properties

# fir.im token (local only, never commit)
scripts/.fir-token
scripts/__pycache__/
**/__pycache__/
*.pyc

# marketing/video v3 pipeline: rendered deliverables, AI footage binaries, runtime state
/marketing/video/output/
/marketing/video/**/__pycache__/
/marketing/video/assets/footage/**/*.mp4
/marketing/video/tools/*.json

# opencode project-local config/state
.opencode/

# HarmonyOS (harmony/) build artifacts + local signing/IDE state
harmony/.idea/
harmony/.hvigor/
harmony/.cxx/
harmony/.clangd/
harmony/.preview/
harmony/oh_modules/
harmony/**/oh_modules/
harmony/**/build/
harmony/.appanalyzer/
harmony/local.properties
harmony/.signing/
harmony/tools/
# 构建产物（HAP 等二进制不进 git，挂 GitHub Release 分发）
harmony/release/

# Local Sentry project configuration (public DSNs, environment-specific)
**/cc-pocket-sentry.properties
# Local analytics ingress origin (public endpoint only, never an MP API secret)
**/cc-pocket-analytics.properties
iosApp/Sentry.local.xcconfig

# Generated public Sentry settings for a single iOS archive
/iosApp/Observability.generated.xcconfig
