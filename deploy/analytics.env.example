# Desktop analytics ingress — server-side configuration for the relay.
#
# Contract: docs/observability/DESKTOP-GA4-INGRESS.md (§5 streams, §2 token key, §7 logging).
# The real file lives on the relay host at /etc/cc-pocket-relay/analytics.env, mode 0600,
# owner ccpocket:ccpocket, and is loaded by cc-pocket-relay.service via EnvironmentFile=-.
# It is NEVER committed: the Measurement Protocol api_secret exists only on that host — not in
# this repo, not in CI, not in any client package. This file holds placeholders only.
#
#   install -m 0600 -o ccpocket -g ccpocket analytics.env /etc/cc-pocket-relay/analytics.env
#   systemctl restart cc-pocket-relay
#
# Master switch. Anything other than true keeps /v1/analytics/register and /v1/analytics/collect
# answering 204, and the relay, Sentry and the desktop app all keep working unchanged.
CCPOCKET_ANALYTICS_ENABLED=true

# One GA4 data stream per environment, as "<measurement_id>:<mp_api_secret>". Events are routed by
# their own app_environment field; development/unknown and unconfigured environments are counted
# and dropped (204), so the production stream never receives probes.
CCPOCKET_ANALYTICS_STREAM_PRODUCTION=G-XXXXXXXX:REPLACE_WITH_MP_API_SECRET
CCPOCKET_ANALYTICS_STREAM_STAGING=G-YYYYYYYY:REPLACE_WITH_MP_API_SECRET

# HMAC key for the anonymous install tokens (hex, at least 64 hex characters = 32 bytes).
# Leave blank to generate a random key at every boot — then a relay restart invalidates all
# outstanding tokens and clients simply re-register. Rotating the key needs no client update.
#   openssl rand -hex 32
CCPOCKET_ANALYTICS_TOKEN_KEY=

# 1 adds GA4 debug_mode to staging events only (never production). Keep 0 in normal operation.
CCPOCKET_ANALYTICS_DEBUG=0
