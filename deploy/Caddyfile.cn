{
    admin 127.0.0.1:2019
    servers {
        protocols h1 h2
    }
}

# Activate only after ICP approval, DNS and public HTTPS verification.
# Keep the old HK entry points and the single existing relay process/database.
relay.pairlet.cn {
    @analytics path /v1/analytics/*
    request_body @analytics {
        max_size 8KB
    }
    reverse_proxy 127.0.0.1:19000 {
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
    }
}
