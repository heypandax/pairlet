{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CC Pocket support knowledge candidate",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "questions",
    "answer",
    "evidence",
    "capturedAt",
    "validation"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^kb-[a-f0-9]{12}$"},
    "status": {
      "enum": ["observed", "stale"]
    },
    "questions": {
      "type": "object",
      "properties": {
        "zh": {"type": "array", "items": {"type": "string"}},
        "en": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "zh": {"type": "string"},
        "en": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidenceSummary": {"type": "string"},
    "capturedBy": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path",
          "startLine",
          "endLine",
          "commit",
          "fileSha256",
          "excerptSha256"
        ],
        "properties": {
          "kind": {"const": "code"},
          "path": {"type": "string"},
          "startLine": {"type": "integer", "minimum": 1},
          "endLine": {"type": "integer", "minimum": 1},
          "commit": {"type": "string"},
          "fileSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "excerptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
