<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CCPocketSentryDSN</key>
    <string>$(CCPOCKET_SENTRY_DSN_IOS)</string>
    <key>CCPocketSentryEnvironment</key>
    <string>$(CCPOCKET_SENTRY_ENVIRONMENT)</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>CC Pairlet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>2.0.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.ccpocket.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ccpocket</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>19</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_ccpocket._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Pairlet uses the camera to scan the pairing QR code shown by cc-pocket-daemon pair on your computer.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Pairlet uses Face ID to lock the app, so only you can open your sessions and approve tool actions.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pairlet connects to the daemon running on your computer over the local network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Pairlet uses the mic to dictate prompts. Audio is transcribed for this message only — nothing is recorded or stored.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Pairlet uses Apple speech recognition to transcribe your dictation so you can speak prompts instead of typing them.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- #334: universal (TARGETED_DEVICE_FAMILY 1,2) requires the iPad contract below. Opting out of
	     Split View / Slide Over with UIRequiresFullScreen leaves rotation as the only iPad multitasking
	     obligation, and the ~ipad array satisfies it. Removing either key while the target stays
	     universal is what App Store validation rejects. -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
